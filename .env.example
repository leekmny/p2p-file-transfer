# 이 파일을 .env로 복사한 뒤 값을 채우세요.  (copy .env.example .env)

# [필수] 친구와 공유할 접속 비밀번호 (8자 이상, 길고 추측하기 어렵게)
APP_PASSWORD=

PORT=3000
# 기본값 127.0.0.1 = 이 PC에서만 접근 가능. 외부 접근은 tailscale serve가 HTTPS로 중계합니다.
HOST=127.0.0.1

# 로그인 유지 시간(시간)
SESSION_TTL_HOURS=12

# --- tailscale serve / cloudflared 같은 HTTPS 프록시 뒤에서 실행할 때 ---
# 프록시가 넘겨주는 X-Forwarded-For로 실제 접속자 IP를 판단 (로그인 시도 제한용)
TRUST_PROXY=1
# 쿠키를 HTTPS에서만 전송 (LAN에서 http://192.168.x.x 로 테스트할 땐 0으로)
COOKIE_SECURE=1
# 접속 주소. 예: https://my-pc.tail1234.ts.net  (쉼표로 여러 개)
ALLOWED_ORIGINS=

# --- ICE 서버 ---
# STUN: 공인 IP 확인용. 빈 값으로 두면 사용 안 함
# STUN_URLS=stun:stun.l.google.com:19302
# TURN: 직접 연결이 안 되는 네트워크용 중계 서버 (README 참고)
# TURN_URLS=turn:100.64.0.1:3478
# TURN_SECRET=coturn의 static-auth-secret 값
