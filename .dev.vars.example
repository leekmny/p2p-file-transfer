# 로컬 개발용 환경 변수 파일입니다.
# 이 파일을 .dev.vars 로 복사한 뒤 값을 채우세요. (Copy-Item .dev.vars.example .dev.vars)
# 실제 배포 시에는 `npx wrangler secret put <변수명>` 으로 등록합니다.

# ================================================================
# 1) 소셜 로그인 (추천 — 비밀번호 없이 Google / GitHub 1클릭 로그인)
#    메일 서버나 도메인 없이 무료 사용 가능!
#    외부인 차단을 위해 ALLOWED_EMAILS 또는 INVITE_CODE(첫 로그인 1회 확인)와 함께 쓰세요.
# ================================================================
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ADMIN_EMAILS=me@gmail.com
# ALLOWED_EMAILS=me@gmail.com,friend@gmail.com
# INVITE_CODE=친구에게-알려줄-가입-초대코드

# ================================================================
# 2) 관리자 비밀번호 로그인 (오른쪽 위 작은 '관리자로 로그인' 버튼)
# ================================================================
APP_PASSWORD=

# ================================================================
# 3) (선택) 이메일 회원가입 + 6자리 인증 메일 발송
# ================================================================
# SESSION_SECRET=충분히-긴-랜덤-세션키

# --- 메일 발송기 (셋 중 1개 선택) ---
# [방법 1] Resend (월 3,000통 무료, 본인 도메인 권장)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=P2P File Transfer <no-reply@yourdomain.com>

# [방법 2] Brevo (일 300통 무료)
# BREVO_API_KEY=xkeysib-xxxxxxxxx
# EMAIL_FROM=P2P File Transfer <no-reply@yourdomain.com>

# [방법 3] Custom Webhook (도메인 없이 본인 Gmail + Google Apps Script 5줄로 무료 발송 가능 — README 참고)
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
# EMAIL_WEBHOOK_SECRET=웹훅-공유-비밀키

# ================================================================
# 3) AI 연동 관리 (웹 내장 AI 비서 + 원격 MCP 서버 /mcp)
#    - 웹 내장 AI 비서: 기본은 Cloudflare Workers AI (무료, 키 불필요)
#    - 외부 LLM(OpenAI / Gemini 등)을 쓰고 싶을 때만 아래 AI_API_* 설정
#    - 원격 MCP(/mcp): ADMIN_API_KEY (16자 이상) 등록 시 활성화
# ================================================================
# ADMIN_API_KEY=32자-이상의-랜덤-관리자-API키
# AI_API_KEY=sk-xxxx 또는 Gemini API 키
# AI_API_BASE=https://api.openai.com/v1   # Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gpt-4o-mini                    # Gemini: gemini-2.5-flash
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ================================================================
# 4) (선택) Cloudflare Access 이메일 인증
# ================================================================
# ACCESS_TEAM_DOMAIN=내팀이름.cloudflareaccess.com
# ACCESS_AUD=Access앱의-Application-Audience-태그

# ================================================================
# 5) (선택) STUN / TURN
# ================================================================
# ALLOWED_ORIGINS=https://p2p-file-transfer.내계정.workers.dev
# STUN_URLS=stun:stun.l.google.com:19302
# CF_TURN_TOKEN_ID=
# CF_TURN_API_TOKEN=
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=
